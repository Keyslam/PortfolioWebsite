				</svg>
				<span>Itch.io</span>
			</a></li>
			<li><a href="https://ldjam.com/users/{{author.ludumdare}}">
				<svg xmlns="http://www.w3.org/2000/svg" version='1.1' aria-hidden='true' viewBox="0 0 130 82">
					<path transform='translate(58 0)' d="M0 80.1h33.094c50.5 0 50.5-78.209 0-78.209H0zm28.938-30.278V31.834h4.714c9.944 0 10.056 17.988 0 17.988z"></path><path d="M34.014 49.809c-2.43 0-4.86-1.956-4.86-5.866V1.758L0 1.89v45.728C0 69.238 16.284 80.1 32.569 80.1h25.083V49.809z"></path>
				</svg>
				<span>LudumDare</span>
			</a></li>
			<li><a href="https://youtube.com/user/{{author.youtube}}">
				<svg xmlns="http://www.w3.org/2000/svg" version='1.1' aria-hidden='true' viewBox="0 0 24 24">
					<path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
				</svg>
				<span>YouTube</span>
			</a></li>
		</ul>
		<p>Website by <a href="https://pablomayobre.github.io/">Pablo Ariel Mayobre</a></p>
  </footer>
</body>

</html>