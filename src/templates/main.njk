<!DOCTYPE html>
<html prefix="og: http://ogp.me/ns#">

<head lang='en'>
	<title>{{ author.firstname + " " + author.lastname + " - " + title }}</title>
	<meta charset='utf-8'/>
	<meta name='viewport' content='width=device-width, initial-scale=1.0'/>
	{% if author.ganalytics %}
	<!-- Global site tag (gtag.js) - Google Analytics -->
	<script async src="https://www.googletagmanager.com/gtag/js?id={{ author.ganalytics }}"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());

		gtag('config', '{{ author.ganalytics }}');
	</script>
	{% endif %}

	<!-- Open Graph Protocol metadata ( https://ogp.me/ ) -->
	<meta property="og:title" content='{{ title }}'/>
	<meta property="og:type" content="profile"/>
	<meta property="og:profile:first_name" content='{{ author.firstname }}'/>
	<meta property="og:profile:last_name" content='{{ author.lastname }}'/>
	<meta property="og:profile:username" content='{{ author.username }}'/>
	<meta property="og:profile:gender" content='{{ author.gender }}'/>
	<meta property="og:url" content='{{ url }}'/>
	<meta property="og:image" content="http://tjakka5.sorunome.de/img/logo/android-chrome-256x256.png"/>

	<!-- Normalize CSS -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css"/>
	 <!-- Google Fonts: Raleway dnd Source Code Pro -->
  <link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Source+Code+Pro|Raleway:300,400,700&display=swap'/>
	<!-- Prism Theme -->
	<link rel='stylesheet' href='{{" /css/duotone-dark.css" | url }}'/>
	<!-- Custom Styles-->
  <link rel='stylesheet' href='{{ "/css/main.css"         | url }}'/>
	<!-- Favicons generated with https://realfavicongenerator.net/ -->
	<link rel="apple-touch-icon"      sizes="180x180" href='{{ "/img/logo/apple-touch-icon.png" | url }}'>
	<link rel="icon" type="image/png" sizes="32x32"   href='{{ "/img/logo/favicon-32x32.png"    | url }}'>
	<link rel="icon" type="image/png" sizes="16x16"   href='{{ "/img/logo/favicon-16x16.png"    | url }}'>
	<link rel="manifest" href='{{ "/static/site.webmanifest" | url }}'>
	<link rel="mask-icon" href='{{ "/img/logo/safari-pinned-tab.svg" | url }}' color="#603cba">
	<link rel="shortcut icon" href='{{ "/img/logo/favicon.ico" | url }}'>
	<meta name="msapplication-TileColor" content="#603cba">
	<meta name="msapplication-TileImage" content='{{ "/img/logo/mstile-144x144.png" | url }}'>
	<meta name="msapplication-config"    content='{{ "/static/browserconfig.xml"    | url }}'>
	<meta name="theme-color" content="#ffffff">
  {% block head %}
  {% endblock %}
</head>

<body>
  <div id="loadOverlay" style="background-color:#fff; position:absolute; top:0px; left:0px; width:100%; height:100%; z-index:2000;"></div>
	<header>
		<img src='{{ "/img/logo/android-chrome-256x256.png" | url }}'/>
		<h1>{{ author.firstname + " " + author.lastname }}</h1>
		<p class='about'>{{ author.about }}</p>
	</header>
	<main>
	<section class="sticky">
		<nav>
			<a {% if title == "About me"  %}class='selected' href='#'{% else %}href='{{ "/about/"   | url }}'{% endif %}>About me </a>
			<a {% if title == "Portfolio" %}class='selected' href='#'{% else %}href='{{ "/"         | url }}'{% endif %}>Portfolio</a>
			<a {% if title == "Contact"   %}class='selected' href='#'{% else %}href='{{ "/contact/" | url }}'{% endif %}>Contact  </a>
			<a {% if title == "Blog"      %}class='selected' href='#'{% else %}href='{{ "/blog/"    | url }}'{% endif %}>Blog     </a>
		</nav>
		<div class="separator">
			<span class="icon">
				{% block icon %}
				  <svg xmlns="http://www.w3.org/2000/svg" version='1.1' aria-hidden='true' width='50' height='50' viewBox='0 0 16 16'>
						<path fill-rule="evenodd" d="M12 1C9.79 1 8 2.31 8 3.92c0 1.94.5 3.03 0 6.08 0-4.5-2.77-6.34-4-6.34.05-.5-.48-.66-.48-.66s-.22.11-.3.34c-.27-.31-.56-.27-.56-.27l-.13.58S.7 4.29.68 6.87c.2.33 1.53.6 2.47.43.89.05.67.79.47.99C2.78 9.13 2 8 1 8S0 9 1 9s1 1 3 1c-3.09 1.2 0 4 0 4H3c-1 0-1 1-1 1h6c3 0 5-1 5-3.47 0-.85-.43-1.79-1-2.53-1.11-1.46.23-2.68 1-2 .77.68 3 1 3-2 0-2.21-1.79-4-4-4zM2.5 6c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5z"></path>
					</svg>
				{% endblock %}
			</span>
			<h2>{{ separator or title }}</h2>
		</div>
	</section>
    {% block main %}
      <section class="markdown">
        {{ content | safe }}
      </section>
    {% endblock %}
  </main>
  <footer>
		<ul class="social">
			<li><a href="https://github.com/{{author.github}}">
				<svg xmlns="http://www.w3.org/2000/svg" version='1.1' aria-hidden='true' viewBox="0 0 24 24">
					<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
				</svg>
				<span>GitHub</span>
			</a></li>
			<li><a href="https://{{author.itchio}}.itch.io/">
				<svg xmlns="http://www.w3.org/2000/svg" version='1.1' aria-hidden='true' viewBox="0 0 245.371 220.736">
					<path d="M31.99 1.365C21.287 7.72.2 31.945 0 38.298v10.516C0 62.144 12.46 73.86 23.773 73.86c13.584 0 24.902-11.258 24.903-24.62 0 13.362 10.93 24.62 24.515 24.62 13.586 0 24.165-11.258 24.165-24.62 0 13.362 11.622 24.62 25.207 24.62h.246c13.586 0 25.208-11.258 25.208-24.62 0 13.362 10.58 24.62 24.164 24.62 13.585 0 24.515-11.258 24.515-24.62 0 13.362 11.32 24.62 24.903 24.62 11.313 0 23.773-11.714 23.773-25.046V38.298c-.2-6.354-21.287-30.58-31.988-36.933C180.118.197 157.056-.005 122.685 0c-34.37.003-81.228.54-90.697 1.365zm65.194 66.217a28.025 28.025 0 0 1-4.78 6.155c-5.128 5.014-12.157 8.122-19.906 8.122a28.482 28.482 0 0 1-19.948-8.126c-1.858-1.82-3.27-3.766-4.563-6.032l-.006.004c-1.292 2.27-3.092 4.215-4.954 6.037a28.5 28.5 0 0 1-19.948 8.12c-.934 0-1.906-.258-2.692-.528-1.092 11.372-1.553 22.24-1.716 30.164l-.002.045c-.02 4.024-.04 7.333-.06 11.93.21 23.86-2.363 77.334 10.52 90.473 19.964 4.655 56.7 6.775 93.555 6.788h.006c36.854-.013 73.59-2.133 93.554-6.788 12.883-13.14 10.31-66.614 10.52-90.474-.022-4.596-.04-7.905-.06-11.93l-.003-.045c-.162-7.926-.623-18.793-1.715-30.165-.786.27-1.757.528-2.692.528a28.5 28.5 0 0 1-19.948-8.12c-1.862-1.822-3.662-3.766-4.955-6.037l-.006-.004c-1.294 2.266-2.705 4.213-4.563 6.032a28.48 28.48 0 0 1-19.947 8.125c-7.748 0-14.778-3.11-19.906-8.123a28.025 28.025 0 0 1-4.78-6.155 27.99 27.99 0 0 1-4.736 6.155 28.49 28.49 0 0 1-19.95 8.124c-.27 0-.54-.012-.81-.02h-.007c-.27.008-.54.02-.813.02a28.49 28.49 0 0 1-19.95-8.123 27.992 27.992 0 0 1-4.736-6.155zm-20.486 26.49l-.002.01h.015c8.113.017 15.32 0 24.25 9.746 7.028-.737 14.372-1.105 21.722-1.094h.006c7.35-.01 14.694.357 21.723 1.094 8.93-9.747 16.137-9.73 24.25-9.746h.014l-.002-.01c3.833 0 19.166 0 29.85 30.007L210 165.244c8.504 30.624-2.723 31.373-16.727 31.4-20.768-.773-32.267-15.855-32.267-30.935-11.496 1.884-24.907 2.826-38.318 2.827h-.006c-13.412 0-26.823-.943-38.318-2.827 0 15.08-11.5 30.162-32.267 30.935-14.004-.027-25.23-.775-16.726-31.4L46.85 124.08C57.534 94.073 72.86