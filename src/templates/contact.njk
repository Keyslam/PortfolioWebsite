				</svg>
			</span>
			<span class="description">Itch.io:</span>
			<a href="https://{{author.itchio}}.itch.io/">@{{author.itchio}}</a>
		</div>

		<div class="field">
			<span class="icon">
				<svg xmlns="http://www.w3.org/2000/svg" version='1.1' aria-hidden='true' viewBox="0 0 130 82">
					<path transform='translate(58 0)' d="M0 80.1h33.094c50.5 0 50.5-78.209 0-78.209H0zm28.938-30.278V31.834h4.714c9.944 0 10.056 17.988 0 17.988z"></path>
