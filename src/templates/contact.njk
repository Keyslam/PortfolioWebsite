{% extends "main.njk" %}

{% block head %}
	<meta property="og:type" content="profile"/>
	<meta property="og:profile:first_name" content='{{ author.firstname }}'/>
	<meta property="og:profile:last_name" content='{{ author.lastname }}'/>
	<meta property="og:profile:username" content='{{ author.username }}'/>
	<meta property="og:profile:gender" content='{{ author.gender }}'/>
	<meta property="og:image" content="http://tjakka5.sorunome.de/img/logo/android-chrome-256x256.png"/>
{% endblock %}

{% block icon %}
	<svg xmlns="http://www.w3.org/2000/svg" version='1.1' aria-hidden='true' width="50" height="50" viewBox="0 0 16 16">
		<path fill-rule="evenodd" d="M16 12.999c0 .439-.45 1-1 1H7.995c-.539 0-.994-.447-.995-.999H1c-.54 0-1-.561-1-1 0-2.634 3-4 3-4s.229-.409 0-1c-.841-.621-1.058-.59-1-3 .058-2.419 1.367-3 2.5-3s2.442.58 2.5 3c.058 2.41-.159 2.379-1 3-.229.59 0 1 0 1s1.549.711 2.42 2.088C9.196 9.369 10 8.999 10 8.999s.229-.409 0-1c-.841-.62-1.058-.59-1-3 .058-2.419 1.367-3 2.5-3s2.437.581 2.495 3c.059 2.41-.158 2.38-1 3-.229.59 0 1 0 1s3.005 1.366 3.005 4z"></path>
	</svg>
{% endblock %}

{% block main %}
	<section class="markdown">
		<h2 id="contact">
			<a class="direct-link" href="#contact" aria-hidden="true">
				<svg viewBox="0 0 16 16" version="1.1" width="16" height="16" aria-hidden="true">
					<path fill-rule="evenodd" d="M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z"></path>
				</svg>
			</a>
      Contact
    </h2>

		<div class="field">
			<span class="icon">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 16" version="1.1" width="12" height="16" aria-hidden="true">
					<path fill-rule="evenodd" d="M6 0C2.69 0 0 2.5 0 5.5 0 10.02 6 16 6 16s6-5.98 6-10.5C12 2.5 9.31 0 6 0zm0 14.55C4.14 12.52 1 8.44 1 5.5 1 3.02 3.25 1 6 1c1.34 0 2.61.48 3.56 1.36.92.86 1.44 1.97 1.44 3.14 0 2.94-3.14 7.02-5 9.05zM8 5.5c0 1.11-.89 2-2 2-1.11 0-2-.89-2-2 0-1.11.89-2 2-2 1.11 0 2 .89 2 2z"></path>
				</svg>
			</span>
			<span class="description">Location:</span>
			<a href="https://www.google.com/maps/search/?api=1&query={{author.city + ', ' + author.country | urlencode}}">{{author.city}}, {{author.country}}</a>
		</div>

		<div class="field">
			<span class="icon">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 16" version="1.1" width="10" height="16" aria-hidden="true">
					<path fill-rule="evenodd" d="M9 0H1C.45 0 0 .45 0 1v14c0 .55.45 1 1 1h8c.55 0 1-.45 1-1V1c0-.55-.45-1-1-1zM5 15.3c-.72 0-1.3-.58-1.3-1.3 0-.72.58-1.3 1.3-1.3.72 0 1.3.58 1.3 1.3 0 .72-.58 1.3-1.3 1.3zM9 12H1V2h8v10z"></path>
				</svg>
			</span>
			<span class="description">Phone:</span>
			<a href="tel:{{author.phone}}">{{author.phone}}</a>
		</div>

		<div class="field">
			<span class="icon">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 16" version="1.1" width="14" height="16" aria-hidden="true">
					<path fill-rule="evenodd" d="M6 5H4V4h2v1zm3 1H4v1h5V6zm5-.48V14c0 .55-.45 1-1 1H1c-.55 0-1-.45-1-1V5.52c0-.33.16-.63.42-.81L2 3.58V3c0-.55.45-1 1-1h1.2L7 0l2.8 2H11c.55 0 1 .45 1 1v.58l1.58 1.13c.27.19.42.48.42.81zM3 7.5L7 10l4-2.5V3H3v4.5zm-2 6l4.5-3-4.5-3v6zm11 .5l-5-3-5 3h10zm1-6.5l-4.5 3 4.5 3v-6z"></path>
				</svg>
			</span>
			<span class="description">E-Mail:</span>
			<a href="mailto:{{author.email}}">{{author.email}}</a>
		</div>

		<h2 id="links">
			<a class="direct-link" href="#contact" aria-hidden="true">
				<svg viewBox="0 0 16 16" version="1.1" width="16" height="16" aria-hidden="true">
					<path fill-rule="evenodd" d="M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z"></path>
