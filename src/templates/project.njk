{% extends "main.njk" %}

{% block icon %}
  <svg xmlns="http://www.w3.org/2000/svg" version='1.1' aria-hidden='true' width="50" height="50" viewBox="0 0 16 16">
    <path fill-rule="evenodd" d="M12.17 3.83c-.27-.27-.47-.55-.63-.88-.16-.31-.27-.66-.34-1.02-.58.33-1.16.7-1.73 1.13-.58.44-1.14.94-1.69 1.48-.7.7-1.33 1.81-1.78 2.45H3L0 10h3l2-2c-.34.77-1.02 2.98-1 3l1 1c.02.02 2.23-.64 3-1l-2 2v3l3-3v-3c.64-.45 1.75-1.09 2.45-1.78.55-.55 1.05-1.13 1.47-1.7.44-.58.81-1.16 1.14-1.72-.36-.08-.7-.19-1.03-.34a3.39 3.39 0 0 1-.86-.63zM16 0s-.09.38-.3 1.06c-.2.7-.55 1.58-1.06 2.66-.7-.08-1.27-.33-1.66-.72-.39-.39-.63-.94-.7-1.64C13.36.84 14.23.48 14.92.28 15.62.08 16 0 16 0z"></path>
  </svg>
{% endblock %}

{% block main %}
  {% if youtube %}
    <div class="cover youtube">
      <div>
        <iframe type="text/html" frameborder="0" allowfullscreen
          src="https://www.youtube.com/embed/{{ youtube }}?autoplay=0&modestbranding=1&rel=0&origin={{author.domain}}">
        </iframe>
      </div>
    </div>
  {% else %}
    <img class="cover" src='{{ "/img/" + image | url }}'/>
  {% endif %}
  {% if itchio %}
    <iframe class="itchio" src="https://itch.io/embed/{{ itchio }}?linkback=true&amp;border_width=2&amp;fg_color=000000&amp;link_color=462d80" width="640" height="173" frameborder="0"></iframe>
  {% endif %}
  <section class="links">
    {% if github     %}<a href="{{ github     }}" class="github"    >GitHub     </a>{% endif %}
    {% if ludumdare  %}<a href="{{ ludumdare  }}" class="ludumdare" >LudumDare  </a>{% endif %}
    {% if googleplay %}<a href="{{ googleplay }}" class="googleplay">Google Play</a>{% endif %}
  </section>
  <section class="markdown">
    {{ content | safe }}
  </section>

{% endblock %}