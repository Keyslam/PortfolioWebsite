  },
  "homepage": "https://github.com/Tjakka5/PortfolioWebsite#readme",
  "devDependencies": {
    "@11ty/eleventy": "^0.8.3",
    "@11ty/eleventy-plugin-syntaxhighlight": "^2.0.1",
    "markdown-it": "^8.4.2",
    "markdown-it-anchor": "^5.0.2",
    "prettier": "^1.18.2"
  }
